# Groq API Key for contextual Q&A response generation
GROQ_API_KEY=""

# Local Hugging Face embedding model selection
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Ingestion text splitter dimensions
CHUNK_SIZE="500"
CHUNK_OVERLAP="50"

# Hybrid search weights configuration (Reciprocal Rank Fusion)
HYBRID_LEXICAL_WEIGHT="0.5"
HYBRID_SEMANTIC_WEIGHT="0.5"
